JWT_SECRET=your-secret-key
OSM_DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/osm
TASK_DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/tasking_manager
TDEI_BACKEND_URL=https://portal-api-dev.tdei.us/api/v1/
# TDEI's public API host (datasets lookup when creating from a dataset). Must
# point at the same environment as TDEI_BACKEND_URL. Required: no default.
TDEI_API_BACKEND_URL=https://api-dev.tdei.us/api/v1/
TDEI_OIDC_REALM=tdei
TDEI_OIDC_URL=https://account-dev.tdei.us/
# External TDEI permission changes may take up to this long to become visible.
WS_USER_INFO_CACHE_TTL_SECONDS=15
